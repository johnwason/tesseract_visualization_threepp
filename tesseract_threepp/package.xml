<?xml version="1.0"?>
<package format="2">
  <name>tesseract_threepp</name>
  <version>0.1.0</version>
  <description>Builds threepp scenes from tesseract environments and markers, for viewers and simulated sensors</description>
  <maintainer email="wason@wasontech.com">John Wason</maintainer>
  <license>Apache 2.0</license>

  <buildtool_depend>cmake</buildtool_depend>
  <build_depend>ros_industrial_cmake_boilerplate</build_depend>
  <!-- threepp has no rosdep key. colcon.pkg orders the build after it. -->
  <depend>tesseract</depend>
  <test_depend>gtest</test_depend>

  <export>
    <build_type>cmake</build_type>
  </export>
</package>
